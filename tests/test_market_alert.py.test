sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import market_alert as m


def at(value):
    return datetime.fromisoformat(value).replace(tzinfo=m.BEIJING)


class ConfigTests(unittest.TestCase):
    def config(self, value):
        return m.load_config({"MARKET_ALERT_CONFIG": json.dumps(value)})

    def test_default_is_gold_only(self):
        self.assertEqual(m.load_config({}).instruments, [m.Instrument("sge", "Au99.99")])

    def test_all_supported_stock_code_formats_and_disabled_items(self):
        config = self.config({"stocks": ["000001", "600519.SH", "bj920002", {"symbol": "sz300750", "enabled": False}], "gold": ["au99.99"]})
        self.assertEqual([i.symbol for i in config.instruments], ["Au99.99", "sz000001", "sh600519", "bj920002"])

    def test_rejects_mistakes_instead_of_silently_changing_watchlist(self):
        cases = [
            {"stocks": [1]}, {"stocks": ["sh000001"]}, {"stocks": ["00700"]},
            {"stocks": ["000001", "sz000001"]}, {"gold": ["XAUUSD"]},
            {"stocks": [{"symbol": "000001", "enabled": "false"}]},
            {"timeout_seconds": 0}, {"stale_minutes": True}, {"stock": []},
            {"calendar_overrides": {"sge": {"closed_dates": ["2026-02-30"]}}},
            {"calendar_overrides": {"a_share": {"closed_dates": ["2026-11-16"], "open_dates": ["2026-11-16"]}}},
        ]
        for value in cases:
            with self.subTest(value=value), self.assertRaises(m.ConfigError):
                self.config(value)

    def test_file_configuration_and_ambiguous_input(self):
        with tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / "config.json"
            path.write_text('{"stocks": ["000001"]}', encoding="utf-8-sig")
            config = m.load_config({"MARKET_ALERT_CONFIG_FILE": str(path)})
            self.assertEqual(config.instruments[0].symbol, "sz000001")
            with self.assertRaises(m.ConfigError):
                m.load_config({"MARKET_ALERT_CONFIG_FILE": str(path), "MARKET_ALERT_CONFIG": "{}"})


class MultiMarketConfigTests(unittest.TestCase):
    def config(self, value):
        return m.load_config({"MARKET_ALERT_CONFIG": json.dumps(value)})

    def test_backwards_compatible_lists_and_all_new_symbol_formats(self):
        config = self.config({"gold": ["Au99.99"], "stocks": ["600519"], "hk_stocks": ["700", "09988.HK"], "hk_connect": ["hk01810"], "us_stocks": ["aapl", "BRK-B"], "crypto": ["BTCUSDT", "ETH-USDT", {"symbol": "SHIB/USDT", "name": "柴犬币"}]})
        self.assertEqual([(i.market, i.symbol) for i in config.instruments], [("sge", "Au99.99"), ("a_share", "sh600519"), ("hk_share", "hk00700"), ("hk_share", "hk09988"), ("hk_connect", "hk01810"), ("us_share", "AAPL"), ("us_share", "BRK.B"), ("crypto", "BTC/USDT"), ("crypto", "ETH/USDT"), ("crypto", "SHIB/USDT")])
        self.assertEqual(config.instruments[-1].name, "柴犬币")

    def test_rejects_ambiguous_or_duplicate_new_symbols(self):
        cases = [
            {"hk_stocks": [700]}, {"hk_stocks": ["00000"]}, {"hk_stocks": ["600519"]},
            {"hk_stocks": ["700", "00700.HK"]}, {"hk_stocks": ["700"], "hk_connect": ["00700"]},
            {"us_stocks": ["BRK-B", "BRK.B"]}, {"us_stocks": ["US:AAPL"]},
            {"us_stocks": ["AAPL&other=value"]}, {"crypto": ["BTC"]},
            {"crypto": ["BTC/USDT/SWAP"]}, {"crypto": ["BTC/BTC"]},
            {"crypto": ["BTCUSDT", "BTC-USDT"]},
            {"calendar_overrides": {"crypto": {"closed_dates": []}}},
            {"calendar_overrides": {"hk_share": {"half_days": ["2026-02-30"]}}},
        ]
        for value in cases:
            with self.subTest(value=value), self.assertRaises(m.ConfigError):
                self.config(value)

    def test_new_markets_can_be_disabled_and_override_calendars(self):
        config = self.config({"hk_stocks": [{"symbol": "00700", "enabled": False}], "us_stocks": ["AAPL"], "calendar_overrides": {"us_share": {"closed_dates": ["2026-11-16"]}, "hk_connect": {"half_days": ["2026-11-16"]}}})
        self.assertEqual(config.instruments, [m.Instrument("us_share", "AAPL")])
        calendar = m.CalendarStore(config, Path("unused"), persist=False)
        self.assertIsNone(calendar.session("us_share", at("2026-11-16T22:30:00")))
        self.assertIsNone(calendar.session("hk_connect", at("2026-11-16T13:30:00")))


class CalendarTests(unittest.TestCase):
    def setUp(self):
        self.calendar = m.CalendarStore(m.Config([]), Path("unused"), persist=False)

    def test_a_share_boundaries_and_lunch(self):
        for clock, opened in (("09:00", False), ("09:30", True), ("11:30", True), ("12:00", False), ("12:30", False), ("13:00", True), ("15:00", True), ("15:30", False)):
            with self.subTest(clock=clock):
                self.assertEqual(bool(self.calendar.session("a_share", at(f"2026-11-16T{clock}:00"))), opened)

    def test_gold_continuous_day_session(self):
        for clock, opened in (("08:30", False), ("09:00", True), ("11:30", True), ("12:00", True), ("13:00", True), ("15:30", True), ("16:00", False)):
            with self.subTest(clock=clock):
                self.assertEqual(bool(self.calendar.session("sge", at(f"2026-11-16T{clock}:00"))), opened)

    def test_friday_night_continues_on_saturday_but_sunday_is_closed(self):
        friday = self.calendar.session("sge", at("2026-11-13T20:00:00"))
        saturday = self.calendar.session("sge", at("2026-11-14T02:30:00"))
        self.assertEqual(friday.trading_day, date(2026, 11, 16))
        self.assertEqual(saturday, friday)
        self.assertIsNone(self.calendar.session("sge", at("2026-11-14T03:00:00")))
        self.assertIsNone(self.calendar.session("sge", at("2026-11-14T20:00:00")))
        self.assertIsNone(self.calendar.session("sge", at("2026-11-15T20:00:00")))
        self.assertIsNone(self.calendar.session("sge", at("2026-11-16T01:00:00")))

    def test_last_friday_before_spring_festival_has_no_night_session(self):
        self.assertIsNotNone(self.calendar.session("sge", at("2026-02-13T15:30:00")))
        self.assertIsNone(self.calendar.session("sge", at("2026-02-13T20:00:00")))
        self.assertIsNone(self.calendar.session("sge", at("2026-02-14T00:30:00")))
        self.assertIsNotNone(self.calendar.session("sge", at("2026-02-24T09:00:00")))
        self.assertIsNone(self.calendar.session("sge", at("2026-02-24T01:00:00")))

    def test_holidays_and_makeup_workdays_remain_closed(self):
        for day in ("2026-10-01", "2026-10-10", "2026-02-28", "2026-09-20"):
            for market in ("sge", "a_share"):
                with self.subTest(day=day, market=market):
                    self.assertIsNone(self.calendar.session(market, at(day + "T10:00:00")))

    def test_calendar_overrides_apply_to_previous_nights_and_midnight(self):
        config = m.Config([], calendar_overrides={"sge": {"closed_dates": ["2026-11-16"], "no_night_dates": ["2026-11-17"]}})
        calendar = m.CalendarStore(config, Path("unused"))
        self.assertFalse(calendar.night_open(date(2026, 11, 13)))
        self.assertIsNone(calendar.session("sge", at("2026-11-18T00:30:00")))

    def test_unknown_year_never_falls_back_to_weekdays(self):
        with patch.object(self.calendar, "fetch_annual", side_effect=OSError("offline")):
            with self.assertRaises(m.CalendarError):
                self.calendar.session("a_share", at("2027-01-05T10:00:00"))

    def test_cross_year_night_requires_next_year_calendar(self):
        with patch.object(self.calendar, "fetch_annual", return_value={"closed_dates": ["2027-01-01"], "no_night_dates": []}):
            self.assertFalse(self.calendar.night_open(date(2026, 12, 31)))

    def test_expected_half_hour_counts(self):
        for market, expected in (("sge", 14), ("a_share", 10)):
            instants = [at("2026-11-16T00:00:00") + m.timedelta(minutes=30 * i) for i in range(48)]
            count = sum(self.calendar.session(market, instant) is not None for instant in instants)
            # 周一白天14次黄金、10次股票，另有周一20:00之后8次夜盘。
            self.assertEqual(count, expected + (8 if market == "sge" else 0))


class GlobalCalendarTests(unittest.TestCase):
    def setUp(self):
        self.calendar = m.CalendarStore(m.Config([]), Path("unused"), persist=False)

    def test_hk_lunch_open_and_close_boundaries(self):
        for market in ("hk_share", "hk_connect"):
            for clock, opened in (("09:00", False), ("09:30", True), ("12:00", True), ("12:30", False), ("13:00", True), ("16:00", True), ("16:30", False)):
                with self.subTest(market=market, clock=clock):
                    self.assertEqual(bool(self.calendar.session(market, at(f"2026-11-16T{clock}:00"))), opened)

    def test_hk_and_southbound_have_different_holidays(self):
        for day in ("2026-01-02", "2026-02-20", "2026-09-25", "2026-10-07"):
            with self.subTest(day=day):
                self.assertIsNotNone(self.calendar.session("hk_share", at(day + "T10:00:00")))
                self.assertIsNone(self.calendar.session("hk_connect", at(day + "T10:00:00")))
        for market in ("hk_share", "hk_connect"):
            for day in ("2026-04-07", "2026-10-19", "2026-12-25", "2026-11-15"):
                with self.subTest(market=market, day=day):
                    self.assertIsNone(self.calendar.session(market, at(day + "T10:00:00")))

    def test_hk_half_day_schedules_and_connect_lunar_new_year_closure(self):
        self.assertEqual(self.calendar.session("hk_share", at("2026-02-16T12:00:00")).name, "半日市")
        self.assertIsNone(self.calendar.session("hk_connect", at("2026-02-16T10:00:00")))
        for market in ("hk_share", "hk_connect"):
            for day in ("2026-12-24", "2026-12-31"):
                with self.subTest(market=market, day=day):
                    self.assertIsNotNone(self.calendar.session(market, at(day + "T12:00:00")))
                    self.assertIsNone(self.calendar.session(market, at(day + "T12:30:00")))
                    self.assertIsNone(self.calendar.session(market, at(day + "T13:00:00")))

    def test_us_dst_and_cross_midnight_use_new_york_trading_day(self):
        for day, opening, closing in (("2026-07-13", "21:30", "04:00"), ("2026-11-16", "22:30", "05:00")):
            start = at(day + "T" + opening + ":00")
            end = at((start.date() + timedelta(days=1)).isoformat() + "T" + closing + ":00")
            with self.subTest(day=day):
                self.assertIsNone(self.calendar.session("us_share", start - timedelta(minutes=30)))
                session = self.calendar.session("us_share", start)
                self.assertEqual(session.end, end)
                self.assertEqual(session.trading_day, start.date())
                self.assertEqual(self.calendar.session("us_share", end), session)
                self.assertIsNone(self.calendar.session("us_share", end + timedelta(minutes=30)))
        self.assertIsNotNone(self.calendar.session("us_share", at("2026-11-14T04:30:00")))
        self.assertIsNone(self.calendar.session("us_share", at("2026-11-16T04:30:00")))

    def test_us_dst_transition_weekdays(self):
        for day, clock, opened in (("2026-03-06", "21:30", False), ("2026-03-09", "21:30", True), ("2026-10-30", "21:30", True), ("2026-11-02", "21:30", False), ("2026-11-02", "22:30", True)):
            with self.subTest(day=day, clock=clock):
                self.assertEqual(bool(self.calendar.session("us_share", at(day + "T" + clock + ":00"))), opened)

    def test_us_holidays_and_early_closes(self):
        self.assertIsNone(self.calendar.session("us_share", at("2026-07-03T21:30:00")))
        self.assertIsNone(self.calendar.session("us_share", at("2026-11-26T22:30:00")))
        self.assertIsNotNone(self.calendar.session("us_share", at("2026-11-28T02:00:00")))
        self.assertIsNone(self.calendar.session("us_share", at("2026-11-28T02:30:00")))
        self.assertIsNone(self.calendar.session("us_share", at("2026-12-25T02:30:00")))

    def test_us_new_year_boundaries_and_previous_year_trading_date(self):
        self.assertIsNone(self.calendar.session("us_share", at("2026-01-01T22:30:00")))
        self.assertIsNone(self.calendar.session("us_share", at("2026-01-02T00:30:00")))
        self.assertIsNone(self.calendar.session("us_share", at("2027-01-01T22:30:00")))
        session = self.calendar.session("us_share", at("2027-01-01T02:00:00"))
        self.assertEqual(session.trading_day, date(2026, 12, 31))
        self.assertEqual(session.end, at("2027-01-01T05:00:00"))

    def test_crypto_remains_open_on_weekends_and_holidays(self):
        for instant in ("2026-11-15T00:00:00", "2026-10-01T23:30:00", "2027-01-01T05:00:00"):
            with self.subTest(instant=instant), patch.object(self.calendar, "annual", side_effect=AssertionError("no stock calendar")):
                session = self.calendar.session("crypto", at(instant))
                self.assertEqual(session.name, "24 小时现货")
                self.assertEqual(session.trading_day, at(instant).date())

    def test_missing_us_dependency_never_falls_back_to_weekdays(self):
        real_import = m.importlib.import_module
        def missing(name):
            if name == "exchange_calendars":
                raise ModuleNotFoundError(name)
            return real_import(name)
        with patch.object(m.importlib, "import_module", side_effect=missing), self.assertRaises(m.CalendarError):
            self.calendar.session("us_share", at("2026-11-16T22:30:00"))

    def test_future_hk_calendar_fetch_cache_and_unknown_year_fail_closed(self):
        with tempfile.TemporaryDirectory() as directory:
            calendar = m.CalendarStore(m.Config([]), Path(directory))
            data = {"closed_dates": ["2027-01-01"], "half_days": ["2027-12-24"]}
            with patch.object(calendar, "fetch_annual", return_value=data) as fetch:
                self.assertEqual(calendar.session("hk_share", at("2027-12-24T12:00:00")).name, "半日市")
                fetch.assert_called_once_with("hk_share", 2027)
            other = m.CalendarStore(m.Config([]), Path(directory))
            with patch.object(other, "fetch_annual", side_effect=AssertionError("cached")):
                self.assertIsNone(other.session("hk_share", at("2027-12-24T13:00:00")))
            with patch.object(other, "fetch_annual", side_effect=OSError("not announced")), self.assertRaises(m.CalendarError):
                other.session("hk_connect", at("2027-11-16T10:00:00"))

    def test_full_hk_csv_parsing_rejects_partial_or_unknown_status(self):
        import csv
        text = io.StringIO()
        text.write("Trading Calendar of Stock Connect (Jan 2027 - Dec 2027)\n")
        writer = csv.writer(text)
        writer.writerow(["Date", "Hong Kong", "Southbound Trading"])
        day = date(2027, 1, 1)
        while day.year == 2027:
            if day.weekday() < 5:
                writer.writerow([day.isoformat(), "Half Day" if day.isoformat() == "2027-12-24" else "Holiday" if day.isoformat() == "2027-01-01" else "", "Closed" if day.isoformat() == "2027-01-01" else ""])
            day += timedelta(days=1)
        valid = text.getvalue()
        self.assertEqual(m.parse_hk_calendar(valid, 2027, "hk_share"), {"closed_dates": ["2027-01-01"], "half_days": ["2027-12-24"]})
        self.assertEqual(m.parse_hk_calendar(valid, 2027, "hk_connect")["half_days"], [])
        for broken in (valid.replace("2027-01-04,,", "2027-01-04,Unknown,"), "\n".join(valid.splitlines()[:-1]), valid.replace("2027-01-04", "2027-01-05"), valid.replace("2027", "2028")):
            with self.subTest(broken=broken[:60]), self.assertRaises(m.CalendarError):
                m.parse_hk_calendar(broken, 2027, "hk_share")


class CalendarParsingTests(unittest.TestCase):
    TEXT = """
    <h1>关于2026年度部分节假日休市安排的公告</h1>
    <p>一、元旦：1月1日（星期四）至1月3日（星期六）休市，2025年12月31日（星期三）晚上无夜市交易。</p>
    <p>二、春节：2月15日（星期日）至2月23日（星期一）休市。2月13日（星期五）晚上无夜市交易。</p>
    <p>三、清明节：4月4日（星期六）至4月6日（星期一）休市。4月3日（星期五）晚上无夜市交易。</p>
    <p>四、劳动节：5月1日（星期五）至5月5日（星期二）休市。4月30日（星期四）晚上无夜市交易。</p>
    <p>五、端午节：6月19日（星期五）至6月21日（星期日）休市。6月18日（星期四）晚上无夜市交易。</p>
    <p>六、中秋节：9月25日（星期五）至9月27日（星期日）休市。9月24日（星期四）晚上无夜市交易。</p>
    <p>七、国庆节：10月1日（星期四）至10月7日（星期三）休市。9月30日（星期三）晚上无夜市交易。</p>
    """

    def test_annual_announcement_ranges_and_previous_year_no_night(self):
        result = m.parse_annual_calendar(self.TEXT, 2026, "sge")
        self.assertIn("2026-02-23", result["closed_dates"])
        self.assertIn("2025-12-31", result["no_night_dates"])
        self.assertIn("2026-09-30", result["no_night_dates"])
        self.assertEqual(len(result["no_night_dates"]), 7)

    def test_incomplete_or_wrong_year_announcement_is_rejected(self):
        incomplete = self.TEXT[:self.TEXT.index("<p>七、")]
        for text, year in ((self.TEXT, 2027), (incomplete, 2026)):
            with self.subTest(year=year), self.assertRaises(m.CalendarError):
                m.parse_annual_calendar(text, year, "sge")

    def test_combined_holiday_heading_preserves_both_closed_ranges(self):
        text = self.TEXT.replace("六、中秋节：", "六、中秋节、国庆节：").replace("</p>\n    <p>七、国庆节：", "")
        result = m.parse_annual_calendar(text, 2026, "sge")
        self.assertIn("2026-09-25", result["closed_dates"])
        self.assertIn("2026-10-07", result["closed_dates"])


class QuoteTests(unittest.TestCase):
    def setUp(self):
        self.gold = m.Instrument("sge", "Au99.99")
        self.stock = m.Instrument("a_share", "sz000001")

    def test_gold_cross_midnight_selects_latest_datetime_not_clock_maximum(self):
        records = [
            {"时间": "23:59:00", "现价": 830, "更新时间": "2026年11月14日 00:31:55"},
            {"时间": "00:30:00", "现价": 835, "更新时间": "2026年11月14日 00:31:55"},
            {"时间": "00:31:00", "现价": 0, "更新时间": "2026年11月14日 00:31:55"},
        ]
        quote = m.gold_quote(self.gold, records, at("2026-11-14T00:32:00"), "test")
        self.assertEqual(quote.price, 835)
        self.assertEqual(quote.quoted_at, at("2026-11-14T00:30:00"))

    def test_gold_evening_trading_date_maps_to_current_calendar_date(self):
        calendar = m.CalendarStore(m.Config([]), Path("unused"))
        now = at("2026-11-16T21:49:00")
        session = calendar.session("sge", now)
        rows = [
            {"时间": "21:45:00", "现价": 831.98, "更新时间": "2026年11月17日 21:45:56"},
            {"时间": "21:46:00", "现价": 999, "更新时间": "2026年11月17日 21:45:56"},
            {"时间": "15:30:00", "现价": 827.49, "更新时间": "2026年11月17日 21:45:56"},
        ]
        quote = m.gold_quote(self.gold, rows, now, "test", session)
        self.assertEqual(quote.price, 831.98)
        self.assertEqual(quote.quoted_at, at("2026-11-16T21:45:00"))
        self.assertTrue(quote.notes)

    def test_friday_and_saturday_quotes_labeled_monday_map_to_actual_night(self):
        calendar = m.CalendarStore(m.Config([]), Path("unused"))
        cases = [
            ("2026-11-13T21:30:00", "2026年11月16日 21:29:55", "21:29:00", "2026-11-13T21:29:00"),
            ("2026-11-14T00:32:00", "2026年11月16日 00:31:55", "00:31:00", "2026-11-14T00:31:00"),
        ]
        for instant, updated, point, expected in cases:
            with self.subTest(instant=instant):
                now = at(instant)
                session = calendar.session("sge", now)
                quote = m.gold_quote(self.gold, [{"时间": point, "现价": 830, "更新时间": updated}], now, "test", session)
                self.assertEqual(quote.quoted_at, at(expected))

    def test_future_night_clock_is_rejected_even_with_correct_trading_date(self):
        calendar = m.CalendarStore(m.Config([]), Path("unused"))
        now = at("2026-11-16T21:49:00")
        with self.assertRaises(m.QuoteError):
            m.gold_quote(self.gold, [{"时间": "22:00:00", "现价": 830, "更新时间": "2026年11月17日 22:01:00"}], now, "test", calendar.session("sge", now))

    def test_gold_zero_nan_and_future_updates_are_rejected(self):
        for value in (0, "-", float("nan"), -100):
            with self.subTest(value=value), self.assertRaises(m.QuoteError):
                m.gold_quote(self.gold, [{"时间": "10:00:00", "现价": value, "更新时间": "2026年11月16日 10:01:00"}], at("2026-11-16T10:02:00"), "test")
        with self.assertRaises(m.QuoteError):
            m.gold_quote(self.gold, [{"时间": "10:00:00", "现价": 830, "更新时间": "2026年11月17日 10:01:00"}], at("2026-11-16T10:02:00"), "test")

    def test_tencent_stock_fields_and_quote_time(self):
        fields = [""] * 40
        fields[1], fields[2], fields[3], fields[30], fields[32] = "平安银行", "000001", "12.07", "20261116103000", "2.37"
        quote = m.tencent_quote(self.stock, 'v_sz000001="' + "~".join(fields) + '";', at("2026-11-16T10:30:05"))
        self.assertEqual((quote.price, quote.change_pct), (12.07, 2.37))
        self.assertEqual(quote.instrument.name, "平安银行")
        self.assertEqual(quote.quoted_at, at("2026-11-16T10:30:00"))

    def test_stale_prior_session_and_unknown_timestamp_are_visible(self):
        calendar = m.CalendarStore(m.Config([]), Path("unused"))
        session = calendar.session("a_share", at("2026-11-16T13:00:00"))
        quote = m.Quote(self.stock, 12, "test", at("2026-11-16T13:00:00"), at("2026-11-16T11:30:00"))
        status = " ".join(m.quote_status(quote, session, 10))
        self.assertIn("行情延迟", status)
        self.assertIn("上一时段价格", status)
        quote.quoted_at = None
        self.assertIn("无法核实延迟", " ".join(m.quote_status(quote, session, 10)))

    def test_stock_source_failure_uses_fallback_only_once_per_run(self):
        config = m.Config([self.stock])
        provider = m.QuoteProvider(config, None, {})
        provider.ak = SimpleNamespace(stock_bid_ask_em=Mock(side_effect=ConnectionError()))
        fields = [""] * 40
        fields[1], fields[2], fields[3], fields[30], fields[32] = "平安银行", "000001", "12.07", "20261116103000", "2.37"
        response = Mock(text='v_sz000001="' + "~".join(fields) + '";')
        with patch("requests.get", return_value=response):
            first = provider.stock(self.stock)
            second = provider.stock(self.stock)
        self.assertEqual(first.price, second.price)
        self.assertEqual(provider.ak.stock_bid_ask_em.call_count, 1)
        self.assertEqual(first.source, "腾讯免费行情")

    def test_gold_night_change_uses_previous_trading_day_close_and_caches_it(self):
        calendar = m.CalendarStore(m.Config([]), Path("unused"))
        session = calendar.session("sge", at("2026-11-13T20:30:00"))
        realtime = Mock()
        realtime.to_dict.return_value = [{"时间": "20:29:00", "现价": 840, "更新时间": "2026年11月13日 20:29:55"}]
        history = Mock()
        history.to_dict.return_value = [{"date": date(2026, 11, 12), "close": 810}, {"date": date(2026, 11, 13), "close": 800}]
        provider = m.QuoteProvider(m.Config([self.gold]), calendar, {})
        provider.ak = SimpleNamespace(spot_realtime_sge=Mock(return_value=realtime), spot_hist_sge=Mock(return_value=history))
        first = provider.gold(self.gold, session)
        second = provider.gold(self.gold, session)
        self.assertAlmostEqual(first.change_pct, 5)
        self.assertEqual(first.change_pct, second.change_pct)
        provider.ak.spot_hist_sge.assert_called_once()

    def test_gold_history_failure_does_not_lose_valid_spot_price(self):
        calendar = m.CalendarStore(m.Config([]), Path("unused"))
        session = calendar.session("sge", at("2026-11-16T10:00:00"))
        realtime = Mock()
        realtime.to_dict.return_value = [{"时间": "10:00:00", "现价": 840, "更新时间": "2026年11月13日 10:01:00"}]
        provider = m.QuoteProvider(m.Config([self.gold]), calendar, {})
        provider.ak = SimpleNamespace(spot_realtime_sge=Mock(return_value=realtime), spot_hist_sge=Mock(side_effect=ConnectionError()))
        quote = provider.gold(self.gold, session)
        self.assertEqual(quote.price, 840)
        self.assertIsNone(quote.change_pct)
        self.assertTrue(quote.notes)

    def test_gold_adapter_failure_falls_back_to_same_sge_contract(self):
        provider = m.QuoteProvider(m.Config([self.gold]), None, {})
        provider.ak = SimpleNamespace(spot_realtime_sge=Mock(side_effect=ConnectionError()))
        response = Mock()
        response.json.return_value = {"heyue": "Au99.99", "times": ["10:00"], "data": [840], "delaystr": "2026年11月13日 10:01:00"}
        with patch("requests.post", return_value=response) as request:
            quote = provider.gold(self.gold, None)
        self.assertEqual(quote.price, 840)
        self.assertEqual(quote.source, "上金所公开行情")
        self.assertEqual(request.call_args.kwargs["data"], {"instid": "Au99.99"})


class GlobalQuoteTests(unittest.TestCase):
    def tencent(self, instrument, code, stamp, currency, price="348.400"):
        fields = [""] * 78
        fields[1], fields[2], fields[3], fields[30], fields[32] = "测试股票", code, price, stamp, "1.25"
        fields[35 if instrument.market == "us_share" else 75] = currency
        return 'v_' + m.tencent_symbol(instrument) + '="' + "~".join(fields) + '";'

    def test_hk_quote_currency_preserves_rmb_counters_and_connect_market(self):
        for market, symbol, currency in (("hk_share", "hk00700", "HKD"), ("hk_share", "hk80700", "CNY"), ("hk_connect", "hk09988", "HKD")):
            instrument = m.Instrument(market, symbol)
            quote = m.tencent_quote(instrument, self.tencent(instrument, symbol[2:], "2026/11/16 10:30:00", currency), at("2026-11-16T10:30:05"))
            self.assertEqual(quote.currency, currency)
            self.assertEqual(quote.quoted_at, at("2026-11-16T10:30:00"))
            self.assertEqual(quote.instrument.market, market)
            _, content = m.build_message(quote.fetched_at, [(instrument, None, quote)], [], m.Config([instrument]))
            self.assertIn("港元/股" if currency == "HKD" else "元/股", content)
            if market == "hk_connect":
                self.assertIn("非人民币结算价", content)

    def test_us_quote_timestamp_and_class_symbols(self):
        instrument = m.Instrument("us_share", "BRK.B")
        for day, local, expected in (("2026-07-13", "16:00:00", "2026-07-14T04:00:00"), ("2026-11-16", "16:00:01", "2026-11-17T05:00:01")):
            with self.subTest(day=day):
                text = self.tencent(instrument, "BRK.B.N", day + " " + local, "USD")
                quote = m.tencent_quote(instrument, text, at(expected) + timedelta(seconds=5))
                self.assertEqual(quote.quoted_at, at(expected))
                self.assertEqual(quote.currency, "USD")
        for code, currency in (("BRK.A.N", "USD"), ("BRK.B.N", "HKD")):
            with self.subTest(code=code, currency=currency), self.assertRaises(m.QuoteError):
                m.tencent_quote(instrument, self.tencent(instrument, code, "2026-11-16 16:00:00", currency), at("2026-11-17T05:00:05"))

    def test_us_etf_quotes_accept_amex_suffix_without_changing_symbol(self):
        instrument = m.Instrument("us_share", "SPY")
        text = self.tencent(instrument, "SPY.AM", "2026-11-16 16:00:01", "USD", "730.20")
        quote = m.tencent_quote(instrument, text, at("2026-11-17T05:00:05"))
        self.assertEqual(quote.price, 730.2)
        self.assertEqual(quote.instrument.symbol, "SPY")

    def test_foreign_quotes_do_not_download_entire_akshare_stock_universe(self):
        instrument = m.Instrument("us_share", "AAPL")
        response = Mock(text=self.tencent(instrument, "AAPL.OQ", "2026-11-16 10:00:00", "USD"))
        provider = m.QuoteProvider(m.Config([instrument], stock_source="akshare"), None, {})
        with patch.object(provider, "akshare", side_effect=AssertionError("no full universe scan")), patch("requests.get", return_value=response) as get:
            self.assertEqual(provider.fetch(instrument, None).currency, "USD")
        self.assertEqual(get.call_args.args[0], "https://qt.gtimg.cn/q=usAAPL")

    def test_crypto_units_low_prices_and_rolling_change(self):
        instant = at("2026-11-16T10:30:00")
        cases = [("BTC/USDT", "63714.42000000", "63,714.42", "USDT/BTC"), ("SHIB/USDT", "0.00000390", "0.0000039", "USDT/SHIB"), ("ETH/BTC", "0.02834000", "0.02834", "BTC/ETH")]
        for symbol, raw, expected, unit in cases:
            with self.subTest(symbol=symbol):
                item = m.Instrument("crypto", symbol)
                payload = {"symbol": symbol.replace("/", ""), "lastPrice": raw, "priceChangePercent": "-1.25", "closeTime": int(instant.timestamp() * 1000)}
                quote = m.crypto_quote(item, payload, instant, "Binance")
                title, content = m.build_message(instant, [(item, None, quote)], [], m.Config([item]))
                self.assertIn("多市场行情", title)
                self.assertIn("现价：" + expected + " " + unit, content)
                self.assertIn("24h 涨跌幅：-1.25%", content)
                self.assertNotIn("美元", content)
                self.assertEqual(quote.quoted_at, instant)

    def test_crypto_midnight_does_not_create_a_false_previous_session_warning(self):
        item = m.Instrument("crypto", "BTC/USDT")
        now = at("2026-11-17T00:00:00")
        session = m.CalendarStore(m.Config([item]), Path("unused")).session("crypto", now)
        quote = m.Quote(item, 63000, "test", now, now - timedelta(seconds=2))
        self.assertNotIn("上一时段", " ".join(m.quote_status(quote, session, 10)))

    def test_okx_timestamp_and_change_are_24h_and_spot_only(self):
        instant = at("2026-11-16T10:30:00")
        item = m.Instrument("crypto", "BTC/USDT")
        row = {"instId": "BTC-USDT", "instType": "SPOT", "last": "105.00", "open24h": "100", "ts": str(int(instant.timestamp()*1000))}
        quote = m.crypto_quote(item, {"code": "0", "data": [row]}, instant, "OKX")
        self.assertAlmostEqual(quote.change_pct, 5)
        self.assertEqual(quote.quoted_at, instant)
        for update in ({"instType": "SWAP"}, {"instId": "ETH-USDT"}, {"last": "0"}, {"ts": "bad"}, {"ts": str(int((instant + timedelta(days=1)).timestamp()*1000))}):
            with self.subTest(update=update), self.assertRaises(m.QuoteError):
                m.crypto_quote(item, {"code": "0", "data": [{**row, **update}]}, instant, "OKX")

    def test_crypto_invalid_or_wrong_symbols_never_become_valid_prices(self):
        item = m.Instrument("crypto", "BTC/USDT")
        instant = at("2026-11-16T10:30:00")
        valid = {"symbol": "BTCUSDT", "lastPrice": "63000", "priceChangePercent": "0", "closeTime": int(instant.timestamp()*1000)}
        for update in ({"symbol": "ETHUSDT"}, {"lastPrice": "NaN"}, {"lastPrice": "0"}, {"lastPrice": "-1"}, {"closeTime": None}):
            with self.subTest(update=update), self.assertRaises(m.QuoteError):
                m.crypto_quote(item, {**valid, **update}, instant, "Binance")
        for payload in ([], {"code": "-1", "data": []}, {"code": "0", "data": [{}]}):
            with self.subTest(payload=payload), self.assertRaises(m.QuoteError):
                m.crypto_quote(item, payload, instant, "OKX")

    def test_crypto_network_failure_switches_remaining_quotes_to_okx(self):
        import requests
        items = [m.Instrument("crypto", symbol) for symbol in ("BTC/USDT", "ETH/USDT")]
        provider = m.QuoteProvider(m.Config(items), None, {})
        def response(url, **kwargs):
            if "binance" in url:
                raise requests.ConnectionError("unavailable")
            item = kwargs["params"]["instId"]
            return Mock(json=Mock(return_value={"code": "0", "data": [{"instId": item, "instType": "SPOT", "last": "105", "open24h": "100", "ts": str(int(datetime.now(m.BEIJING).timestamp()*1000))}]}))
        with patch("requests.get", side_effect=response) as get:
            for item in items:
                quote = provider.fetch(item, None)
                self.assertIn("OKX", quote.source)
                self.assertIn("各交易所价格可能不同", " ".join(quote.notes))
        self.assertEqual(sum("binance" in call.args[0] for call in get.call_args_list), 1)

    def test_missing_crypto_pair_does_not_disable_binance_for_other_pairs(self):
        import requests
        provider = m.QuoteProvider(m.Config([]), None, {})
        bad = Mock(status_code=400, url="https://data-api.binance.vision/api/v3/ticker/24hr")
        failure = requests.HTTPError(response=bad)
        with patch("requests.get", side_effect=failure), self.assertRaises(m.QuoteError):
            provider.crypto(m.Instrument("crypto", "NOTLISTED/USDT"))
        self.assertFalse(provider.crypto_primary_failed)


class GlobalExecutionTests(unittest.TestCase):
    def test_combined_push_selects_each_market_independently(self):
        config = m.load_config({"MARKET_ALERT_CONFIG": json.dumps({"gold": ["Au99.99"], "stocks": ["600519"], "hk_stocks": ["00700"], "hk_connect": ["09988"], "us_stocks": ["AAPL"], "crypto": ["BTCUSDT"]})})
        for instant, expected in (("2026-11-16T10:30:00", {"sge", "a_share", "hk_share", "hk_connect", "crypto"}), ("2026-11-16T12:30:00", {"sge", "crypto"}), ("2026-11-17T03:30:00", {"us_share", "crypto"}), ("2026-11-15T10:00:00", {"crypto"})):
            with self.subTest(instant=instant), tempfile.TemporaryDirectory() as directory, contextlib.redirect_stdout(io.StringIO()):
                fetched = []
                def fetch(item, session):
                    fetched.append(item.market)
                    return m.Quote(item, 100, "test", at(instant), at(instant))
                notify = Mock()
                result = m.run(config, at(instant), Path(directory), provider_factory=lambda *args: SimpleNamespace(fetch=fetch), notify=notify)
                self.assertEqual(result, 0)
                self.assertEqual(set(fetched), expected)
                notify.assert_called_once()
                self.assertIn("多市场行情", notify.call_args.args[0])

    def test_missing_us_calendar_does_not_stop_24h_crypto(self):
        config = m.Config([m.Instrument("us_share", "AAPL"), m.Instrument("crypto", "BTC/USDT")])
        with tempfile.TemporaryDirectory() as directory, patch.object(m.CalendarStore, "us_calendar", side_effect=m.CalendarError("请安装 exchange-calendars")), contextlib.redirect_stdout(io.StringIO()):
            fetch = Mock(side_effect=lambda item, session: m.Quote(item, 100, "test", at("2026-11-16T22:30:00")))
            notify = Mock()
            code = m.run(config, at("2026-11-16T22:30:00"), Path(directory), provider_factory=lambda *args: SimpleNamespace(fetch=fetch), notify=notify)
        self.assertEqual(code, 1)
        self.assertEqual(fetch.call_count, 1)
        self.assertEqual(fetch.call_args.args[0].market, "crypto")
        self.assertIn("请安装 exchange-calendars", notify.call_args.args[1])


class ExecutionTests(unittest.TestCase):
    def setUp(self):
        self.directory = tempfile.TemporaryDirectory()
        self.addCleanup(self.directory.cleanup)
        self.path = Path(self.directory.name)
        self.config = m.Config([m.Instrument("sge", "Au99.99"), m.Instrument("a_share", "sz000001")])
        self.notify = Mock()
        self.output = io.StringIO()
        self.redirect = contextlib.redirect_stdout(self.output)
        self.redirect.__enter__()
        self.addCleanup(self.redirect.__exit__, None, None, None)

    def provider(self, config, calendars, state):
        return SimpleNamespace(fetch=lambda item, session: m.Quote(item, 830 if item.market == "sge" else 12, "test", at("2026-11-16T10:00:05"), at("2026-11-16T10:00:00")))

    def run_script(self, instant, **kwargs):
        return m.run(self.config, at(instant), self.path, provider_factory=self.provider, notify=self.notify, **kwargs)

    def test_combined_push_and_same_slot_deduplication(self):
        self.assertEqual(self.run_script("2026-11-16T10:00:00"), 0)
        self.assertEqual(self.run_script("2026-11-16T10:00:59"), 0)
        self.notify.assert_called_once()
        content = self.notify.call_args.args[1]
        self.assertIn("Au99.99", content)
        self.assertIn("sz000001", content)
        self.run_script("2026-11-16T10:30:00")
        self.assertEqual(self.notify.call_count, 2)

    def test_lunch_and_night_push_only_gold(self):
        for instant in ("2026-11-16T12:00:00", "2026-11-14T01:30:00"):
            self.run_script(instant, dry_run=True)
            message = self.output.getvalue().split("播报时点：", 1)[1]
            self.assertIn("Au99.99", message)
            self.assertNotIn("sz000001", message)
            self.output.seek(0)
            self.output.truncate(0)

    def test_outside_hours_never_fetch(self):
        for instant in ("2026-11-15T10:00:00", "2026-11-16T18:00:00"):
            factory = Mock(side_effect=AssertionError("must not fetch"))
            self.assertEqual(m.run(self.config, at(instant), self.path, provider_factory=factory, notify=self.notify), 0)
            factory.assert_not_called()
        self.notify.assert_not_called()
        self.assertEqual(list(self.path.iterdir()), [])

    def test_delayed_start_and_arbitrary_minute_fetch_during_session(self):
        for instant in ("2026-11-16T10:01:00", "2026-11-16T10:15:00"):
            with self.subTest(instant=instant):
                self.assertEqual(self.run_script(instant), 0)
        self.assertEqual(self.notify.call_count, 2)
        self.assertNotIn("本次跳过", self.output.getvalue())

    def test_manual_run_diagnoses_quotes_and_notification_even_outside_sessions(self):
        self.assertEqual(self.run_script("2026-11-16T18:13:00", manual=True), 0)
        title, content = self.notify.call_args.args
        self.assertIn("手动检查", title)
        self.assertIn("Au99.99", content)
        self.assertIn("sz000001", content)
        self.assertIn("休市", content)
        self.assertNotIn("last_slot", m.read_json(self.path / "state.json"))

    def test_manual_run_does_not_consume_or_overwrite_scheduled_slot(self):
        self.run_script("2026-11-16T10:00:00")
        scheduled = m.read_json(self.path / "state.json")["last_slot"]
        self.run_script("2026-11-16T10:00:00", manual=True)
        self.run_script("2026-11-16T10:03:00", manual=True)
        self.assertEqual(m.read_json(self.path / "state.json")["last_slot"], scheduled)
        self.assertEqual(self.notify.call_count, 3)

    def test_dry_run_check_and_force_do_not_write_or_notify(self):
        self.run_script("2026-11-16T10:00:00", dry_run=True)
        self.run_script("2026-11-15T18:03:00", dry_run=True, force=True)
        self.run_script("2026-11-16T10:00:00", check=True)
        self.notify.assert_not_called()
        self.assertEqual(list(self.path.iterdir()), [])

    def test_partial_failure_still_notifies_other_quotes(self):
        def fetch(item, session):
            if item.market == "sge":
                raise m.QuoteError("黄金接口不可用")
            return self.provider(None, None, None).fetch(item, session)

        factory = lambda *args: SimpleNamespace(fetch=fetch)
        code = m.run(self.config, at("2026-11-16T10:00:00"), self.path, provider_factory=factory, notify=self.notify)
        self.assertEqual(code, 1)
        content = self.notify.call_args.args[1]
        self.assertIn("黄金接口不可用", content)
        self.assertIn("12.00", content)

    def test_failed_notification_does_not_mark_slot_as_sent(self):
        self.notify.side_effect = RuntimeError("send failed")
        with self.assertRaises(RuntimeError):
            self.run_script("2026-11-16T10:00:00")
        self.assertNotIn("last_slot", m.read_json(self.path / "state.json"))
        self.notify.side_effect = None
        self.run_script("2026-11-16T10:00:00")
        self.assertEqual(self.notify.call_count, 2)

    def test_missing_calendar_skips_affected_market_only(self):
        config = m.Config(self.config.instruments, calendar_overrides={"sge": {"open_dates": ["2027-01-05"]}})
        with patch.object(m.CalendarStore, "fetch_annual", side_effect=ConnectionError("offline")):
            code = m.run(config, at("2027-01-05T10:00:00"), self.path, provider_factory=self.provider, notify=self.notify)
        self.assertEqual(code, 1)
        content = self.notify.call_args.args[1]
        self.assertIn("Au99.99", content)
        self.assertNotIn("sz000001", content)
        self.assertIn("无法取得", content)

    def test_state_lock_prevents_concurrent_notifications(self):
        with m.state_lock(self.path):
            with self.assertRaises(m.AlreadyRunning):
                with m.state_lock(self.path):
                    self.fail("lock should be exclusive")
        with m.state_lock(self.path):
            pass


class NotificationTests(unittest.TestCase):
    def test_uses_qinglong_builtin(self):
        api = SimpleNamespace(notify=Mock())
        with patch.object(builtins, "QLAPI", api, create=True), patch.object(m.importlib, "import_module", side_effect=ModuleNotFoundError(name="__ql_notify__")):
            m.send_notification("title", "body")
        api.notify.assert_called_once_with("title", "body")

    def test_falls_back_to_qinglong_module(self):
        module = SimpleNamespace(send=Mock())
        with patch.object(builtins, "QLAPI", None, create=True), patch.object(m.importlib, "import_module", return_value=module):
            m.send_notification("title", "body")
        module.send.assert_called_once_with("title", "body")

    def test_explicit_notification_failure_is_not_recorded_as_success(self):
        with patch.object(builtins, "QLAPI", SimpleNamespace(notify=Mock(return_value=False)), create=True), patch.object(m.importlib, "import_module", side_effect=ModuleNotFoundError(name="__ql_notify__")):
            with self.assertRaises(RuntimeError):
                m.send_notification("title", "body")

    def test_prefers_panel_configuration_and_checks_success_response(self):
        api = SimpleNamespace(systemNotify=Mock(return_value={"code": 200}), notify=Mock())
        with patch.object(builtins, "QLAPI", api, create=True):
            receipt = m.send_notification("title", "body")
        api.systemNotify.assert_called_once_with({"title": "title", "content": "body"})
        api.notify.assert_not_called()
        self.assertIn("确认", receipt)

    def test_panel_failure_or_missing_response_is_an_error(self):
        for result in ({"code": 400}, {"code": 500}, {}, None, False):
            with self.subTest(result=result), patch.object(builtins, "QLAPI", SimpleNamespace(systemNotify=Mock(return_value=result)), create=True):
                with self.assertRaises(m.NotificationError):
                    m.send_notification("title", "body")

    def test_no_script_channels_and_console_only_are_errors(self):
        def console(*args):
            pass

        for channels in ([], [console]):
            sender = Mock()
            module = SimpleNamespace(send=sender, add_notify_function=lambda: channels)
            with self.subTest(channels=channels), patch.object(builtins, "QLAPI", None, create=True), patch.object(m.importlib, "import_module", return_value=module):
                with self.assertRaises(m.NotificationError):
                    m.send_notification("title", "body")
            sender.assert_not_called()

    def test_notification_exceptions_do_not_expose_tokens_or_proxy_credentials(self):
        api = SimpleNamespace(systemNotify=Mock(side_effect=ConnectionError("https://user:password@host/?token=private")))
        with patch.object(builtins, "QLAPI", api, create=True), self.assertRaises(m.NotificationError) as caught:
            m.send_notification("title", "body")
        self.assertNotIn("private", str(caught.exception))
        self.assertNotIn("password", str(caught.exception))

    def test_script_notification_none_result_is_reported_as_unconfirmed(self):
        module = SimpleNamespace(send=Mock(return_value=None))
        with patch.object(builtins, "QLAPI", None, create=True), patch.object(m.importlib, "import_module", return_value=module):
            receipt = m.send_notification("title", "body")
        self.assertIn("日志", receipt)
        self.assertNotIn("成功", receipt)

    def test_rejected_panel_notification_does_not_record_scheduled_slot(self):
        with tempfile.TemporaryDirectory() as directory:
            config = m.Config([m.Instrument("sge", "Au99.99")])
            provider = SimpleNamespace(fetch=lambda item, session: m.Quote(item, 830, "test", at("2026-11-16T10:00:00")))
            api = SimpleNamespace(systemNotify=Mock(return_value={"code": 400}))
            with patch.object(builtins, "QLAPI", api, create=True), self.assertRaises(m.NotificationError):
                m.run(config, at("2026-11-16T10:00:00"), Path(directory), provider_factory=lambda *args: provider)
            self.assertNotIn("last_slot", m.read_json(Path(directory) / "state.json"))


class EntrypointTests(unittest.TestCase):
    def test_manual_schedule_diagnostics_report_mismatch_without_editing_task(self):
        api = SimpleNamespace(getCronDetail=Mock(return_value={"code": 200, "data": {"schedule": "17 18 * * *"}}))
        output = io.StringIO()
        with patch.object(builtins, "QLAPI", api, create=True), patch.dict(os.environ, {"real_log_path": "market/run.log"}), contextlib.redirect_stdout(output):
            m.log_task_schedule()
        api.getCronDetail.assert_called_once_with({"log_path": "market/run.log"})
        self.assertIn("17 18 * * *", output.getvalue())
        self.assertIn("不一致", output.getvalue())

    def test_schedule_lookup_failure_keeps_diagnosis_available(self):
        api = SimpleNamespace(getCronDetail=Mock(side_effect=ConnectionError("private endpoint")))
        output = io.StringIO()
        with patch.object(builtins, "QLAPI", api, create=True), patch.dict(os.environ, {"real_log_path": "market/run.log"}), contextlib.redirect_stdout(output):
            m.log_task_schedule()
        self.assertIn("继续检查", output.getvalue())
        self.assertNotIn("private endpoint", output.getvalue())

    def test_both_filename_and_explicit_cron_annotations_match(self):
        source = (m.ROOT / "market_alert.py").read_text(encoding="utf-8")
        explicit = re.search(r"\bcron:\s*([^\r\n]+)", source)[1].strip()
        filename_lines = [line for line in source.splitlines() if "market_alert.py" in line]
        legacy = [match[0] for line in filename_lines if (match := re.search(r"(?:[\d*][\d*/,-]*\s+){4,5}[\d*][\d*/,-]*", line))]
        self.assertEqual(explicit, m.EXPECTED_SCHEDULE)
        self.assertEqual(legacy, [m.EXPECTED_SCHEDULE])

    def test_main_detects_qinglong_manual_run_without_extra_arguments(self):
        with patch.dict(os.environ, {"real_time": "true", "MARKET_ALERT_CONFIG": "{}", "MARKET_ALERT_CONFIG_FILE": ""}), patch.object(m, "run", return_value=0) as run:
            self.assertEqual(m.main([]), 0)
        self.assertTrue(run.call_args.kwargs["manual"])

    def test_main_does_not_treat_scheduled_or_check_runs_as_manual(self):
        for env, arguments in (({"real_time": "false"}, []), ({"real_time": "true"}, ["--check"])):
            with self.subTest(env=env, arguments=arguments), patch.dict(os.environ, {**env, "MARKET_ALERT_CONFIG": "{}", "MARKET_ALERT_CONFIG_FILE": ""}), patch.object(m, "run", return_value=0) as run:
                self.assertEqual(m.main(arguments), 0)
            self.assertFalse(run.call_args.kwargs["manual"])

    def test_default_subscription_only_finds_the_market_entrypoint(self):
        candidates = []
        for directory, subdirs, filenames in os.walk(m.ROOT):
            subdirs[:] = [name for name in subdirs if not name.startswith(".") and name not in {"node_modules", "__pycache__", "venv"}]
            for filename in filenames:
                path = Path(directory) / filename
                if path.suffix in {".py", ".js", ".ts", ".sh"}:
                    candidates.append(path.relative_to(m.ROOT).as_posix())
        self.assertEqual(candidates, ["market_alert.py"])

    def test_test_script_runs_directly_from_an_unrelated_directory(self):
        with tempfile.TemporaryDirectory() as directory:
            env = {**os.environ, "PYTHONIOENCODING": "utf-8"}
            env.pop("PYTHONPATH", None)
            result = subprocess.run(
                [sys.executable, str(Path(__file__).resolve()), "ConfigTests"],
                cwd=directory, env=env, capture_output=True, encoding="utf-8", timeout=15,
            )
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertIn("Ran 4 tests", result.stderr)

    def test_accidental_qinglong_test_task_exits_without_running_tests(self):
        with tempfile.TemporaryDirectory() as directory:
            # 模拟仅复制了测试文件、且青龙已注入 QLAPI 的脚本目录。
            copied = Path(directory) / "test_market_alert.py"
            copied.write_bytes(Path(__file__).read_bytes())
            result = subprocess.run(
                [sys.executable, "-c", "import builtins, runpy, sys; builtins.QLAPI = object(); runpy.run_path(sys.argv[1], run_name='__main__')", str(copied)],
                cwd=directory, env={**os.environ, "PYTHONIOENCODING": "utf-8"},
                capture_output=True, encoding="utf-8", timeout=15,
            )
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertIn("请停用此任务", result.stdout)
        self.assertIn("market_alert.py", result.stdout)
        self.assertNotIn("Ran ", result.stderr)


if __name__ == "__main__":
    unittest.main()
